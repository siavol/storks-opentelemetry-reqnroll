<Project>
  <!--
    Central Package Management: every package version lives here, csproj files carry no Version.
    Versions shared by a package family are properties so the family moves together.
    Reqnroll has two properties:
    - ReqnrollMinVersion is the oldest Reqnroll the plugin is verified on. The plugin depends on
      [ReqnrollMinVersion, 4.0) and compiles against that lower bound, so the package accepts any 3.x from it up.
    - ReqnrollVersion is the concrete Reqnroll the unit tests and the samples run on (VersionOverride in their
      csproj). Override it from the command line (-p:ReqnrollVersion=3.x.y) to test against another Reqnroll.
    The only version outside this file is the Aspire.AppHost.Sdk MSBuild SDK: MSBuild resolves SDKs before
    any property is evaluated, so it is pinned in global.json ("msbuild-sdks") and must match AspireVersion.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ReqnrollMinVersion>3.0.0</ReqnrollMinVersion>
    <ReqnrollVersion Condition="'$(ReqnrollVersion)' == ''">3.3.4</ReqnrollVersion>
    <AspireVersion>13.6.5</AspireVersion>
    <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
  </PropertyGroup>

  <!-- Plugin -->
  <ItemGroup>
    <PackageVersion Include="Reqnroll" Version="[$(ReqnrollMinVersion), 4.0)" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Analyzers -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Reqnroll.NUnit" Version="$(ReqnrollVersion)" />
  </ItemGroup>

  <!-- Aspire and OpenTelemetry hosting -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>
</Project>
