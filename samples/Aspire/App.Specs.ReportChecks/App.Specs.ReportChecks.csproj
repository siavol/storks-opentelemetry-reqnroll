<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Seam 1: reads the artifacts of an App.Specs run (Cucumber Messages NDJSON). Does not run App.Specs itself.
    Run App.Specs first (needs docker), then:  dotnet test samples/Aspire/App.Specs.ReportChecks
    Override the report location with APP_SPECS_REPORT_DIR.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
</Project>
