<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The E2E fixture: a Reqnroll project with the plugin against Front.Api and Back.Api, started as separate processes.
    One scenario fails on purpose; E2E.ReportChecks reads the reports of its run.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- The plugin depends on a Reqnroll range; run on the concrete ReqnrollVersion instead of its lower bound. -->
    <PackageReference Include="Reqnroll" VersionOverride="$(ReqnrollVersion)" />
    <PackageReference Include="Reqnroll.NUnit" />
    <PackageReference Include="Storks.OpenTelemetry.Reqnroll" />
    <!-- Copies the SUT into the output directory, where the hooks start it. -->
    <ProjectReference Include="..\Front.Api\Front.Api.csproj" />
    <ProjectReference Include="..\Back.Api\Back.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
